// Podcast Theme Styles using nm-stylus-library
// Import the design system library

@import '../../node_modules/nm-stylus-library/index.styl'

// Base styles for the podcast page
html
  background-color: var(--color-black-soft)
  color: var(--color-white-soft)
  font-family: var(--font-family-sans)
  font-size: 19px
  letter-spacing: 0.001em
  margin: 0
  padding: 0

body
  margin: 0
  padding: 0

.container
  max-width: 700px
  margin: 1rem
  padding: 0

.logomark
  max-width: 40px
  height: auto

h1
  font-size: 24px
  font-weight: 500
  margin: 0

a
  color: var(--color-white-soft)
  text-decoration: underline

  &:hover
    text-decoration: none

// Keep list styling simple
ul
  margin: 1em 0
  padding-left: 2em

li
  margin: 0.5em 0

p
  margin: 1em 0